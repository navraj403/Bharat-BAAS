# Copy to .env.local and fill in. Never commit real values. (docs/BUILD_PLAN.md §6.2)

# Supabase project URL (used for "open in Supabase Table Editor" links in the DB explorer).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key. Not used by the server path; kept for completeness.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Postgres via the Supabase TRANSACTION POOLER (port 6543). The app uses prepare:false.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# 1 = UI uses local fixtures (src/lib/client/fixtures.ts) instead of the API. 0 = real API.
NEXT_PUBLIC_USE_FIXTURES=0
# 1 = show demo helpers (demo-number chips, simulate-failure toggle).
NEXT_PUBLIC_DEMO_MODE=1
